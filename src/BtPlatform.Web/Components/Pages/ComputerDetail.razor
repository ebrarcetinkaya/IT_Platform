    // ---- Uzaktan komut ----

    private CatalogCommand? SelectedCatalog => RemoteCommandCatalog.Find(cmdKey);

    private IEnumerable<CatalogCommand> VisibleCatalog =>
        RemoteCommandCatalog.All.Where(c => !(computer?.IsReal == true && c.SimulatedOnly));

    private void ShowCmdConfirm()
    {
        cmdMessage = "";
        var reason = RemoteCommandValidator.ValidateReason(cmdReason);
        if (!reason.Ok) { cmdOk = false; cmdMessage = reason.Error!; return; }

        var isReal = computer?.IsReal == true;
        if (cmdMode == "catalog")
        {
            var built = RemoteCommandCatalog.Build(cmdKey, cmdParam, isReal);
            if (!built.Ok) { cmdOk = false; cmdMessage = built.Error!; return; }
        }
        else
        {
            var free = RemoteCommandValidator.ValidateFree(cmdFree, isReal);
            if (!free.Ok) { cmdOk = false; cmdMessage = free.Error!; return; }
        }
        cmdConfirming = true;
    }

    private string CmdPreview()
    {
        var isReal = computer?.IsReal == true;
        return cmdMode == "catalog"
            ? RemoteCommandCatalog.Build(cmdKey, cmdParam, isReal).Command ?? ""
            : cmdFree.Trim();
    }

    private async Task RunCommand()
    {
        // Sunucu tarafı: sadece Admin
        var admin = await Guard.RequireAdminAsync("Uzaktan komut oluşturma denemesi");
        if (admin is null)
        {
            cmdOk = false; cmdMessage = "Bu işlem için yetkiniz yok."; cmdConfirming = false;
            return;
        }

        var request = cmdMode == "catalog"
            ? new RemoteCommandRequest(Id, cmdKey, cmdParam, null, cmdReason)
            : new RemoteCommandRequest(Id, null, null, cmdFree, cmdReason);

        var result = await RemoteCommands.CreateAsync(admin, request);
        cmdConfirming = false;

        if (!result.Ok)
        {
            cmdOk = false; cmdMessage = result.Error!;
            return;
        }

        var job = result.Job!;
        await Audit.LogAsync(admin, "Uzaktan komut oluşturuldu",
            $"İş #{job.Id} · {job.Hostname} ({(job.IsRealTarget ? "GERÇEK" : "simüle")}) · komut: {job.CommandText} · gerekçe: {job.Reason}");

        cmdOk = true;
        cmdMessage = "Komut kuyruğa alındı.";
        cmdFree = ""; cmdReason = "";
        await Refresh();
    }

