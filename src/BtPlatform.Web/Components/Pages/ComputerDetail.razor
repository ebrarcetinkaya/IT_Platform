    // ---- Canlı ölçüm kartları için yardımcılar ----

    private static double? Used(double? total, double? free) =>
        total is null || free is null ? null : total - free;

    private static double Pct(double? part, double? total) =>
        part is null || total is null || total <= 0
            ? 0
            : Math.Clamp(Math.Round(part.Value * 100 / total.Value), 0, 100);

    // %85 üstü kırmızı, %70 üstü sarı
    private static string BarClass(double? part, double? total)
    {
        var p = Pct(part, total);
        return p >= 85 ? "bg-danger" : p >= 70 ? "bg-warning" : "bg-success";
    }

